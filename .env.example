# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário:
# cp .env.example .env

# Senha do superusuário root do MySQL
MYSQL_ROOT_PASSWORD=sua_senha_root_aqui

# Nome do banco de dados que será criado automaticamente
MYSQL_DATABASE=unibibliodb

# ATENÇÃO: NÃO use "root" em MYSQL_USER!
# A imagem oficial do MySQL proíbe MYSQL_USER=root (o root já é criado via MYSQL_ROOT_PASSWORD).
# Defina um usuário comum para a aplicação:
MYSQL_USER=unibiblio_user
MYSQL_PASSWORD=sua_senha_usuario_aqui
